#!/bin/bash

source "${XDG_CONFIG_HOME:-$HOME/.config}/i3blocks/wombat.sh"

set -euo pipefail

# Totales acumulados de las interfaces, sin el tráfico local de loopback.
totals=$(awk -F ':' '
    /:/ {
        interface = $1
        gsub(/[[:space:]]/, "", interface)
        if (interface == "lo") next
        split($2, counters, " ")
        downloaded += counters[1]
        uploaded += counters[9]
    }
    END { printf "D:%.2fG U:%.2fG", downloaded / 1000000000, uploaded / 1000000000 }
' /proc/net/dev)

printf '%s\n%s\n%s\n' "$totals" "$totals" "$wombat_green"
