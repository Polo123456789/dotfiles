# vim:ft=i3config

floating_maximum_size -1 x -1
for_window [class="floating_window"] floating enable

default_floating_border pixel 1
default_border pixel 1

for_window [all] border pixel 1

popup_during_fullscreen smart

focus_follows_mouse no

hide_edge_borders smart


#                       border          background      text          indicator       child_border
client.focused          $wombat_fg      $wombat_fg      $wombat_bg    $wombat_blue    $wombat_fg
client.focused_inactive $wombat_border  $wombat_surface $wombat_muted $wombat_border  $wombat_border
client.unfocused        $wombat_border  $wombat_surface $wombat_muted $wombat_border  $wombat_border
client.urgent           $wombat_red     $wombat_red     $wombat_bg    $wombat_red     $wombat_red
