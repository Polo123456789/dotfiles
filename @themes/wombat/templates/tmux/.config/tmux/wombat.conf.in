# Generated by @themes/wombat/generate.py. Edit palette.json instead.
set -g status-style 'fg={{muted}},bg={{background}}'
set -g window-status-style 'fg={{muted}},bg={{background}}'
set -g window-status-current-style 'fg={{foreground}},bg={{selection}},bold'
set -g window-status-activity-style 'fg={{blue}},bg={{background}}'
set -g window-status-bell-style 'fg={{red}},bg={{background}}'
set -g pane-border-style 'fg={{border}}'
set -g pane-active-border-style 'fg={{foreground}}'
set -g message-style 'fg={{foreground}},bg={{surface}}'
set -g message-command-style 'fg={{foreground}},bg={{surface}}'
set -g mode-style 'fg={{selection_text}},bg={{selection}}'
set -g display-panes-colour '{{muted}}'
set -g display-panes-active-colour '{{blue}}'
set -g clock-mode-colour '{{blue}}'
set -g popup-style 'fg={{foreground}},bg={{background}}'
set -g popup-border-style 'fg={{border}},bg={{background}}'
