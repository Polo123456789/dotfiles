/* Generated by @themes/wombat/generate.py. Adwaita color overrides. */
@define-color theme_bg_color {{background}};
@define-color theme_fg_color {{foreground}};
@define-color theme_base_color {{background}};
@define-color theme_text_color {{foreground}};
@define-color theme_selected_bg_color {{blue}};
@define-color theme_selected_fg_color {{background}};
@define-color theme_unfocused_bg_color {{background}};
@define-color theme_unfocused_fg_color {{muted}};
@define-color theme_unfocused_base_color {{background}};
@define-color theme_unfocused_text_color {{foreground}};
@define-color theme_unfocused_selected_bg_color {{selection}};
@define-color theme_unfocused_selected_fg_color {{selection_text}};
@define-color insensitive_bg_color {{surface}};
@define-color insensitive_fg_color {{muted}};
@define-color insensitive_base_color {{background}};
@define-color borders {{border}};
@define-color unfocused_borders {{border}};
@define-color warning_color {{yellow}};
@define-color error_color {{red}};
@define-color success_color {{green}};

window, .background, menu, menubar, popover, .popover, dialog,
notebook, notebook > stack, stack, scrolledwindow, viewport {
    background-image: none;
    background-color: {{background}};
    color: {{foreground}};
}
headerbar, toolbar, .toolbar, .primary-toolbar, .sidebar, notebook > header,
searchbar > revealer > box {
    background-image: none;
    background-color: {{surface}};
    color: {{foreground}};
    border-color: {{border}};
}
entry, .view, textview, textview text, list, row {
    background-color: {{background}};
    color: {{foreground}};
}
entry, frame, notebook > header, separator {
    border-color: {{border}};
}
button {
    background-image: none;
    background-color: {{surface}};
    color: {{foreground}};
    border-color: {{border}};
    text-shadow: none;
}
button:hover, row:hover, menuitem:hover {
    background-image: none;
    background-color: {{border}};
    color: {{foreground}};
}
button:active, button:checked, button.suggested-action,
row:selected, .view:selected, menuitem:hover,
entry selection, textview text selection {
    background-image: none;
    background-color: {{blue}};
    color: {{background}};
}
button.destructive-action {
    background-color: {{red}};
    color: {{background}};
}
button:disabled, entry:disabled, label:disabled {
    color: {{muted}};
}
check:checked, radio:checked, switch:checked,
progressbar progress, scale highlight {
    background-image: none;
    background-color: {{blue}};
    color: {{background}};
    border-color: {{blue}};
}
progressbar trough, scale trough {
    background-color: {{surface}};
    border-color: {{border}};
}
scale slider {
    background-image: none;
    background-color: {{foreground}};
    border-color: {{border}};
    border-radius: 999px;
}
separator {
    background-color: {{border}};
}
notebook > header > tabs > tab {
    color: {{foreground}};
}
notebook > header > tabs > tab:checked {
    color: {{blue}};
    box-shadow: inset 0 -2px {{blue}};
}
tooltip, tooltip.background {
    background-color: {{surface}};
    color: {{foreground}};
    border-color: {{border}};
}
*:link { color: {{blue}}; }
*:visited { color: {{magenta}}; }
