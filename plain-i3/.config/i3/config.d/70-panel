# vim:ft=i3config

bindsym $mod+i bar mode toggle

bar {
  position top
  mode dock
  font pango:Monocraft 8
  separator_symbol " "
  status_command i3blocks
  tray_output HDMI-A-0
  tray_output eDP
  tray_output primary
  strip_workspace_numbers yes
  workspace_min_width 24

  colors {
      background $wombat_bg
      statusline $wombat_fg
      separator  $wombat_border

      #                  BORDER     BACKGROUND TEXT
      focused_workspace  $wombat_fg     $wombat_fg      $wombat_bg
      active_workspace   $wombat_border $wombat_surface $wombat_fg
      inactive_workspace $wombat_bg     $wombat_bg      $wombat_muted
      urgent_workspace   $wombat_red    $wombat_red     $wombat_bg
  }
}
