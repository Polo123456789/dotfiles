#!/bin/bash

gsettings set org.gnome.desktop.interface icon-theme Papirus-Dark

# Qt's built-in KDE palette reader supports both Qt 5 and Qt 6, without Plasma.
export QT_QPA_PLATFORMTHEME=kde
export KDE_SESSION_VERSION=5
export QT_STYLE_OVERRIDE=Fusion
dbus-update-activation-environment --systemd QT_QPA_PLATFORMTHEME QT_STYLE_OVERRIDE KDE_SESSION_VERSION

# No system wide config, only I need this
xset dpms 0 0 300
xrandr --output eDP --dpi 120
