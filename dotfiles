#!/bin/bash

dotfiles_script="$(realpath "$0")"
dotfiles_dir="$HOME/dotfiles"
hooks_dir="$dotfiles_dir/@hooks"

if ! command -v hostname &> /dev/null; then
  machine_hostname="$(cat /etc/hostname)"
else
  machine_hostname="$(hostname)"
fi

export DOTFILES_CONFIG_DIR="$HOME/.config/dotfiles"
if [ ! -d "$DOTFILES_CONFIG_DIR" ]; then
  mkdir -p "$DOTFILES_CONFIG_DIR"
fi

help-msg() {
  echo "Usage: $0 <command> [options]"
  echo
  echo "Commands:"
  echo "  stow <package> [package2] ... [packagen] --args"
  echo "    Stow the specified package(s), passing --args to stow"
  echo
  echo "  unstow <package> [package2] ... [packagen] --args"
  echo "    Unstow the specified package(s), passing --args to stow"
  echo
  echo "  adopt <package> [package2] ... [packagen] --args"
  echo "    Adopt the specified package(s), passing --args to stow"
  echo
  echo "  restow <package> [package2] ... [packagen] --args"
  echo "    Restow the specified package(s)"
  echo
  echo "  branch-out"
  echo "    Create a new branch with the machine hostname"
  echo
  echo "  pull-master"
  echo "    Pull the latest changes from the master branch and rebase the current branch"
  echo
  echo "  git <git-command>"
  echo "    Run a git command in the dotfiles repository"
  echo
}

dotfiles-git() {
  git --git-dir="$dotfiles_dir/.git" --work-tree="$dotfiles_dir" "$@"
}

dotfiles-stow() {
  stow -t "$HOME" -d "$dotfiles_dir" --ignore='@.*' -v "$@"
}

# If there is no output, the package is stowed
package-is-stowed() {
  local package="$1"
  dotfiles-stow -n --verbose=1 "$package" 2>&1 | grep -v "WARNING"
}

stow-dependencies() {
  local package="$1"
  local dependencies_file="$dotfiles_dir/$package/@depends"

  if [ -f "$dependencies_file" ]; then
    local dependencies
    dependencies="$(cat "$dependencies_file")" || return $?

    echo "Package $package depends on:"
    for dependency in $dependencies; do
      echo "  * $dependency"
    done
    read -p "Do you want to stow them? [y/N] " -n 1 -r answer
    echo

    if [[ ! $answer =~ ^[Yy]$ ]]; then
      echo "Skipping dependencies"
      return 0
    fi

    echo "Going into dependencies:"
    for dependency in $dependencies; do
      "$dotfiles_script" stow "$dependency" "${stow_options[@]}" || return $?
    done
  fi
}

unstow-dependencies() {
  local package="$1"
  local dependencies_file="$dotfiles_dir/$package/@depends"

  if [ -f "$dependencies_file" ]; then
    local dependencies
    dependencies="$(cat "$dependencies_file")" || return $?

    echo "Package $package depends on:"
    for dependency in $dependencies; do
      echo "  * $dependency"
    done
    read -p "Do you want to unstow them? [y/N] " -n 1 -r answer
    echo

    if [[ ! $answer =~ ^[Yy]$ ]]; then
      echo "Skipping dependencies"
      return 0
    fi

    echo "Going into dependencies:"
    for dependency in $dependencies; do
      if [ -n "$(package-is-stowed "$dependency")" ]; then
        echo "Dependency $dependency is not stowed"
      else
        "$dotfiles_script" unstow "$dependency"
      fi
    done
  fi
}

run-hook() (
  local package="$1"
  local hook="$2"
  cd "$HOME" || exit
  if [ -f "$hooks_dir/$package/$hook" ]; then
    "$hooks_dir/$package/$hook"
  fi
)

install-packages() {
  local action="$1" package hook_action arg dry_run=false
  shift
  local -a packages=() stow_options=()
  for arg in "$@"; do
    case "$arg" in
      -n|--simulate) dry_run=true; stow_options+=("$arg") ;;
      -*) stow_options+=("$arg") ;;
      *) packages+=("$arg") ;;
    esac
  done
  if [ "${#packages[@]}" -eq 0 ]; then
    echo "Specify a package" >&2
    return 1
  fi
  if [ "$action" = restow ]; then
    stow_options+=(--restow)
  fi
  for package in "${packages[@]}"; do
    [ -d "$dotfiles_dir/$package" ] || { echo "Unknown package: $package" >&2; return 1; }
    # Detect file conflicts before hooks can install packages or change preferences.
    dotfiles-stow --simulate --no-folding "${stow_options[@]}" "$package" || return $?
    if "$dry_run"; then
      stow-dependencies "$package" || return $?
      continue
    fi
    hook_action=stow
    if [ "$action" = restow ] || [ -z "$(package-is-stowed "$package")" ]; then
      hook_action=restow
    fi
    run-hook "$package" "pre-$hook_action" || return $?
    stow-dependencies "$package" || return $?
    dotfiles-stow --no-folding "${stow_options[@]}" "$package" || return $?
    run-hook "$package" "post-$hook_action" || return $?
  done
}

case "$1" in
  "stow")
    shift
    install-packages stow "$@"
    exit $?
    ;;
  "unstow")
    shift
    unstow-dependencies "$1"
    run-hook "$1" "pre-unstow"
    dotfiles-stow -D "$@" 2>&1 | grep -v 'BUG'
    run-hook "$1" "post-unstow"
    exit 0
    ;;
  "adopt")
    shift
    dotfiles-stow --adopt "$@"
    exit 0
    ;;
  "restow")
    shift
    install-packages restow "$@"
    exit $?
    ;;
  "branch-out")
    dotfiles-git checkout -b "$machine_hostname"
    exit 0
    ;;
  "pull-master")
    dotfiles-git checkout master
    dotfiles-git pull
    dotfiles-git checkout "$machine_hostname"
    dotfiles-git rebase master
    exit 0
    ;;
  "git")
    shift
    dotfiles-git "$@"
    ;;
  *)
    help-msg
    exit 1
    ;;
esac



